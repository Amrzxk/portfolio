---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatDate, readingTime } from '../lib/collections';

interface Props {
  post: CollectionEntry<'blog'>;
  index?: number;
  headingLevel?: 'h2' | 'h3';
}
const { post, index = 0, headingLevel: H = 'h3' } = Astro.props;
const d = post.data;
---

<article class="card card-hover post reveal" style={`--d:${index % 3}`}>
  {d.cover && <img class="cover" src={d.cover} alt="" loading="lazy" decoding="async" />}
  <p class="meta mono">
    <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime(post.body)}</span>
  </p>
  <H class="title"><a href={`/blog/${post.id}/`} class="stretched">{d.title}</a></H>
  <p class="desc">{d.description}</p>
  {
    d.tags.length > 0 && (
      <ul class="chip-list">
        {d.tags.map((t) => (
          <li class="chip">#{t}</li>
        ))}
      </ul>
    )
  }
  <span class="link read">Read <Icon name="arrow" size={16} /></span>
</article>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .cover {
    margin: calc(-1 * clamp(20px, 3vw, 28px)) calc(-1 * clamp(20px, 3vw, 28px)) 6px;
    width: calc(100% + 2 * clamp(20px, 3vw, 28px));
    max-width: none;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius) var(--radius) 0 0;
    border-bottom: 1px solid var(--border);
  }
  .meta {
    display: flex;
    gap: 8px;
    font-size: 0.78rem;
    color: var(--faint);
  }
  .title {
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .desc {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .read {
    margin-top: auto;
    padding-top: 4px;
  }
</style>
