---
import Icon from '../Icon.astro';
import { about, site } from '../../lib/data';

interface Props {
  title: string;
  kicker: string;
}
const { kicker } = Astro.props;
const paragraphs = about.body.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const initials = site.name
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<section id="about" class="section">
  <div class="container about-grid">
    <div class="portrait reveal">
      {
        about.photo ? (
          <img src={about.photo} alt={`Portrait of ${site.name}`} loading="lazy" decoding="async" />
        ) : (
          <div class="monogram" aria-hidden="true">
            <span>{initials}</span>
          </div>
        )
      }
      {
        about.availability.text && (
          <p class:list={['availability', { closed: !about.availability.open }]}>
            <span class="pulse" aria-hidden="true" />
            {about.availability.text}
          </p>
        )
      }
      {
        site.location && (
          <p class="location">
            <Icon name="pin" size={16} />
            {site.location}
          </p>
        )
      }
    </div>

    <div class="about-copy">
      <p class="kicker reveal">{kicker}</p>
      <h2 class="reveal">{about.heading}</h2>
      <div class="body">
        {paragraphs.map((p) => <p class="reveal">{p}</p>)}
      </div>
      {
        about.highlights.length > 0 && (
          <ul class="highlights">
            {about.highlights.map((h, i) => (
              <li class="reveal" style={`--d:${i}`}>
                <span class="tick">
                  <Icon name="check" size={14} />
                </span>
                {h}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .portrait {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
  }
  .portrait img,
  .monogram {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .monogram {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 20%, var(--accent-glow), transparent 60%),
      linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 28px 28px,
      var(--surface);
  }
  .monogram span {
    font-size: clamp(4rem, 9vw, 7rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    color: var(--text);
    opacity: 0.9;
  }
  .availability,
  .location {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .availability {
    color: var(--text);
    font-weight: 500;
  }
  .pulse {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--success);
    flex: none;
  }
  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--success);
    animation: ping 2s ease-out infinite;
  }
  .closed .pulse,
  .closed .pulse::after {
    background: var(--faint);
    animation: none;
  }
  @keyframes ping {
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  h2 {
    font-size: clamp(1.9rem, 2.6vw + 1rem, 2.9rem);
  }
  .body {
    margin-top: 22px;
    display: grid;
    gap: 16px;
    color: var(--muted);
    font-size: clamp(1rem, 0.3vw + 0.97rem, 1.1rem);
  }
  .highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
    margin-top: 32px;
  }
  .highlights li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.95rem;
  }
  .tick {
    display: grid;
    place-items: center;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent-ink);
    margin-top: 1px;
  }
  @media (max-width: 799px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .portrait {
      position: static;
      max-width: 340px;
    }
  }
</style>
