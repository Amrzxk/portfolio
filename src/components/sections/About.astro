---
import SectionHead from '../SectionHead.astro';
import { about, site } from '../../lib/data';

interface Props {
  title: string;
  kicker: string;
}
const { title, kicker } = Astro.props;
const paragraphs = about.body.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const initials = site.name
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<section id="about" class="section">
  <div class="container">
    <SectionHead kicker={kicker} title={title} heading={about.heading} />

    <div class="grid">
      <figure class="portrait reveal">
        {
          about.photo ? (
            <img src={about.photo} alt={`Portrait of ${site.name}`} loading="lazy" decoding="async" />
          ) : (
            <div class="placeholder" aria-hidden="true">
              <span class="display">{initials}</span>
            </div>
          )
        }
        <figcaption class="mono">
          <span>fig. 01</span>
          <span>{site.name.toLowerCase()}</span>
        </figcaption>
      </figure>

      <div class="text">
        <div class="body">
          {paragraphs.map((p, i) => <p class:list={['reveal', { lead: i === 0 }]}>{p}</p>)}
        </div>

        <dl class="facts mono reveal">
          {
            about.availability.text && (
              <div>
                <dt>status</dt>
                <dd>
                  <span class:list={['dot', { off: !about.availability.open }]} aria-hidden="true" />
                  {about.availability.text}
                </dd>
              </div>
            )
          }
          {
            site.location && (
              <div>
                <dt>based</dt>
                <dd>{site.location}</dd>
              </div>
            )
          }
        </dl>

        {
          about.highlights.length > 0 && (
            <ul class="highlights">
              {about.highlights.map((h, i) => (
                <li class="reveal" style={`--d:${i}`}>
                  <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
                  {h}
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 24px;
  }
  .portrait {
    margin: 0;
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    align-self: start;
  }
  .portrait img,
  .placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 3px;
    border: 1px solid var(--border);
    filter: saturate(0.9) contrast(1.02);
  }
  .placeholder {
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(135deg, transparent 0 7px, var(--border) 7px 8px), var(--surface);
  }
  .placeholder span {
    font-size: 3.4rem;
    font-stretch: 112.5%;
    color: var(--accent-ink);
    background: var(--surface);
    padding: 0 0.15em;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
    font-size: 0.7rem;
    color: var(--faint);
  }
  .text {
    max-width: 720px;
  }
  .body {
    display: grid;
    gap: 18px;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .body .lead {
    font-size: clamp(1.25rem, 0.6vw + 1.05rem, 1.5rem);
    line-height: 1.45;
    font-weight: 500;
    color: var(--text);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0 32px;
    margin: 32px 0 0;
    padding: 16px 0;
    border-block: 1px solid var(--border);
    font-size: 0.82rem;
  }
  .facts div {
    display: flex;
    gap: 14px;
    padding: 4px 0;
  }
  .facts dt {
    color: var(--faint);
    min-width: 6ch;
  }
  .facts dd {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-ink);
    flex: none;
  }
  .dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: inherit;
    animation: ping 2.2s ease-out infinite;
  }
  .dot.off,
  .dot.off::after {
    background: var(--faint);
    animation: none;
  }
  @keyframes ping {
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 32px;
    margin-top: 8px;
  }
  .highlights li {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.97rem;
  }
  .n {
    color: var(--accent-ink);
    font-size: 0.74rem;
    padding-top: 0.25em;
  }
  @media (max-width: 759px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .portrait {
      position: static;
      max-width: 220px;
    }
    .highlights {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
