---
import SectionHead from '../SectionHead.astro';
import { certifications } from '../../lib/data';

interface Props {
  title: string;
  kicker: string;
}
const { title, kicker } = Astro.props;
---

<section id="certifications" class="section">
  <div class="container">
    <SectionHead kicker={kicker} title={title} intro={certifications.intro} />
    <ul class="certs">
      {
        certifications.items.map((c, i) => (
          <li class="cert reveal" style={`--d:${i % 4}`}>
            <span class="yr mono">{c.date || '—'}</span>
            <span class="badge">
              {c.badge ? (
                <img src={c.badge} alt="" loading="lazy" decoding="async" width="40" height="40" />
              ) : /progress|prep|ongoing/i.test(c.date) ? (
                <span class="tick pending mono" title="In progress">◌</span>
              ) : (
                <span class="tick mono">✓</span>
              )}
            </span>
            <span class="info">
              <span class="name">{c.name}</span>
              <span class="issuer mono">
                {c.issuer}
                {c.credentialId && <> · id {c.credentialId}</>}
              </span>
            </span>
            {c.verifyUrl ? (
              <a class="verify mono u" href={c.verifyUrl} target="_blank" rel="noopener noreferrer">
                verify ↗
              </a>
            ) : (
              <span />
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .certs {
    border-top: 1px solid var(--border);
  }
  .cert {
    display: grid;
    grid-template-columns: 96px 40px minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  .yr {
    font-size: 0.8rem;
    color: var(--faint);
  }
  .badge {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 3px;
  }
  .badge img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .tick {
    color: var(--accent-ink);
  }
  .tick.pending {
    color: var(--muted);
  }
  .info {
    display: grid;
    gap: 2px;
  }
  .name {
    font-weight: 500;
  }
  .issuer {
    font-size: 0.74rem;
    color: var(--faint);
  }
  .verify {
    font-size: 0.78rem;
    color: var(--muted);
  }
  @media (max-width: 959px) {
    .certs {
      margin-left: 0;
    }
  }
  @media (max-width: 519px) {
    .cert {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 4px 14px;
    }
    .yr {
      grid-column: 2;
      grid-row: 2;
    }
    .badge {
      grid-row: span 2;
    }
    .verify {
      grid-column: 2;
    }
  }
</style>
