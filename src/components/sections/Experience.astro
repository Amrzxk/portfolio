---
import SectionHead from '../SectionHead.astro';
import { experience } from '../../lib/data';

interface Props {
  title: string;
  kicker: string;
}
const { title, kicker } = Astro.props;
---

<section id="experience" class="section">
  <div class="container">
    <SectionHead kicker={kicker} title={title} intro={experience.intro} />
    <ol class="jobs">
      {
        experience.items.map((j) => (
          <li class="job reveal">
            <p class="when mono">
              {j.start} <span class="faint">—</span> {j.current ? 'present' : j.end || 'present'}
              {j.current && <span class="now">● now</span>}
            </p>
            <div class="what">
              <h3>
                {j.role}
                <span class="at">
                  {' '}
                  at{' '}
                  {j.companyUrl ? (
                    <a class="u" href={j.companyUrl} target="_blank" rel="noopener noreferrer">
                      {j.company}
                    </a>
                  ) : (
                    j.company
                  )}
                </span>
              </h3>
              {j.location && <p class="loc mono">{j.location}</p>}
              {j.summary && <p class="summary">{j.summary}</p>}
              {j.highlights.length > 0 && (
                <ul class="hl">
                  {j.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
              {j.stack.length > 0 && <p class="stack mono">{j.stack.join(' / ')}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .job {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 10px 24px;
    padding: 28px 0;
    border-top: 1px solid var(--border);
  }
  .job:last-child {
    border-bottom: 1px solid var(--border);
  }
  .when {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 4px 6px;
    padding-top: 0.3em;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .now {
    width: 100%;
    color: var(--accent-ink);
    font-size: 0.72rem;
  }
  .what {
    max-width: 760px;
  }
  h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 1.2vw + 1.1rem, 2.1rem);
    line-height: 1.1;
  }
  .at {
    font-style: italic;
    color: var(--accent-ink);
  }
  .at .u {
    color: inherit;
  }
  .loc {
    margin-top: 6px;
    font-size: 0.74rem;
    color: var(--faint);
  }
  .summary {
    margin-top: 14px;
    color: var(--muted);
  }
  .hl {
    display: grid;
    gap: 8px;
    margin: 16px 0 18px;
  }
  .hl li {
    position: relative;
    padding-left: 24px;
    font-size: 0.97rem;
  }
  .hl li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent-ink);
  }
  .stack {
    font-size: 0.74rem;
    color: var(--faint);
  }
  @media (max-width: 759px) {
    .job {
      grid-template-columns: minmax(0, 1fr);
    }
    .now {
      width: auto;
      margin-left: 8px;
    }
  }
</style>
