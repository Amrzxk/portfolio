---
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { skills } from '../../lib/data';

interface Props {
  title: string;
  kicker: string;
}
const { title, kicker } = Astro.props;
const levelText = ['', 'familiar', 'working knowledge', 'proficient', 'advanced', 'expert'];
---

<section id="skills" class="section">
  <div class="container">
    <SectionHead kicker={kicker} title={title} intro={skills.intro} />

    <div class="domains">
      {
        skills.domains.map((d, i) => (
          <article class="domain reveal" style={`--d:${i}`}>
            <header>
              <span class="mono idx">{String(i + 1).padStart(2, '0')}</span>
              <Icon name={d.icon} size={18} class="ic" />
              <h3>{d.name}</h3>
            </header>
            {d.summary && <p class="sum">{d.summary}</p>}
            <ul class="list">
              {d.skills.map((s) => (
                <li>
                  <span>{s.name}</span>
                  <span class="meter mono" role="img" aria-label={`${levelText[s.level]}, ${s.level} of 5`} title={levelText[s.level]}>
                    {[1, 2, 3, 4, 5].map((n) => (
                      <i class:list={{ on: n <= s.level }} />
                    ))}
                  </span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    {
      skills.toolbelt.length > 0 && (
        <p class="tools mono reveal">
          <span class="faint">also in the toolbelt —</span>
          {skills.toolbelt.map((t, i) => (
            <>
              <span class="tool">{t}</span>
              {i < skills.toolbelt.length - 1 && <span class="sep" aria-hidden="true">/</span>}
            </>
          ))}
        </p>
      )
    }
  </div>
</section>

<style>
  .domains {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }
  .domain {
    padding: clamp(20px, 3vw, 32px);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    transition: background-color 0.3s;
  }
  .domain:hover {
    background: var(--surface);
  }
  header {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .idx {
    font-size: 0.74rem;
    color: var(--faint);
  }
  header :global(.ic) {
    color: var(--accent-ink);
  }
  h3 {
    font-size: 1.12rem;
    font-weight: 600;
  }
  .sum {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .list {
    margin-top: 20px;
  }
  .list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 9px 0;
    border-top: 1px dashed var(--border);
    font-size: 0.94rem;
  }
  .meter {
    display: inline-flex;
    gap: 3px;
    flex: none;
  }
  .meter i {
    width: 7px;
    height: 12px;
    background: var(--border-strong);
  }
  .meter i.on {
    background: var(--accent-ink);
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin-top: 28px;
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.8;
  }
  .sep {
    color: var(--border-strong);
  }
  @media (max-width: 799px) {
    .domains {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
