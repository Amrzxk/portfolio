---
import SectionHead from '../SectionHead.astro';
import { resume, site } from '../../lib/data';

interface Props {
  title: string;
  kicker: string;
}
const { title, kicker } = Astro.props;
const user = (site.name.split(' ')[0] || 'me').toLowerCase();
const fileName = resume.file.split('/').pop() || 'resume.pdf';
---

{
  resume.file && (
    <section id="resume" class="section">
      <div class="container">
        <SectionHead kicker={kicker} title={title} intro={resume.intro} />
        <div class="wrap reveal">
          {resume.points.length > 0 && (
            <ul class="points">
              {resume.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          )}
          <div class="file">
            <p class="cmd mono">
              <span class="g">$</span> ls -l ~/documents
            </p>
            <a class="row mono" href={resume.file} download>
              <span class="perm">-rw-r--r--</span>
              <span class="own">{user}</span>
              <span class="date">{resume.updated || ''}</span>
              <span class="name">{fileName}</span>
              <span class="dl">↓</span>
            </a>
            <div class="actions">
              <a class="btn btn-primary" href={resume.file} download>
                {resume.buttonLabel} <span class="arr" aria-hidden="true">↓</span>
              </a>
              <a class="u view mono" href={resume.file} target="_blank" rel="noopener">
                open in browser ↗
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  .points li {
    position: relative;
    padding: 12px 0 12px 24px;
    border-bottom: 1px solid var(--border);
  }
  .points li:first-child {
    border-top: 1px solid var(--border);
  }
  .points li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent-ink);
  }
  .file {
    padding: 20px 22px 22px;
    border-radius: var(--radius);
    background: var(--term-bg);
    border: 1px solid var(--term-border);
    color: var(--term-text);
    box-shadow: var(--term-shadow);
  }
  .cmd {
    font-size: 0.8rem;
    color: var(--term-dim);
  }
  .g {
    color: var(--accent);
  }
  .row {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto auto;
    gap: 14px;
    align-items: center;
    margin-top: 10px;
    padding: 10px 12px;
    border-radius: 3px;
    font-size: 0.8rem;
    color: var(--term-text);
    background: color-mix(in oklab, var(--accent) 7%, transparent);
    border: 1px dashed color-mix(in oklab, var(--accent) 30%, transparent);
    transition: background-color 0.2s;
  }
  .row:hover {
    background: color-mix(in oklab, var(--accent) 14%, transparent);
  }
  .perm,
  .date {
    color: var(--term-dim);
  }
  .name {
    color: var(--accent);
  }
  .dl {
    color: var(--accent);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 22px;
    margin-top: 22px;
  }
  :root[data-theme='light'] .file .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .view {
    font-size: 0.8rem;
    color: var(--term-text);
  }
  @media (max-width: 959px) {
    .wrap {
      margin-left: 0;
    }
  }
  @media (max-width: 699px) {
    .wrap {
      grid-template-columns: minmax(0, 1fr);
    }
    .perm,
    .own {
      display: none;
    }
    .row {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
  }
</style>
