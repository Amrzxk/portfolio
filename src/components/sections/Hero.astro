---
import Terminal from '../Terminal.astro';
import { isEnabled, resume, story } from '../../lib/data';
import { emphasize } from '../../lib/format';

const showResume = story.showResumeButton && isEnabled('resume') && !!resume.file;
---

<section id="hero" class="hero">
  <div class="container hero-grid">
    <div class="copy">
      <p class="prompt mono reveal">
        <span class="g">{story.prompt}</span>
        {story.greeting && <span class="greet">{story.greeting}</span>}
      </p>

      <h1 class="reveal" style="--d:1" set:html={emphasize(story.headline)} />

      <p class="roles mono reveal" style="--d:2">
        <span class="sr-only">{story.roles.join(', ')}</span>
        <span aria-hidden="true">
          <span class="faint">currently ›</span>
          <span data-typed data-roles={JSON.stringify(story.roles)}>{story.roles[0]}</span><span class="caret">_</span>
        </span>
      </p>

      {story.intro && <p class="intro reveal" style="--d:3">{story.intro}</p>}

      <div class="ctas reveal" style="--d:4">
        <a class="btn btn-primary" href={story.primaryCta.href}>
          {story.primaryCta.label} <span class="arr" aria-hidden="true">→</span>
        </a>
        {
          showResume && (
            <a class="btn" href={resume.file} download>
              résumé.pdf <span class="arr" aria-hidden="true">↓</span>
            </a>
          )
        }
      </div>
    </div>

    <div class="term-col reveal" style="--d:2">
      <Terminal />
    </div>
  </div>

  {
    story.stats.length > 0 && (
      <div class="container">
        <dl class="ledger">
          {story.stats.map((s, i) => (
            <div class="stat reveal" style={`--d:${i + 4}`}>
              <dt class="mono">{s.label}</dt>
              <dd class="display">{s.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--nav-h) + clamp(40px, 7vw, 88px));
    padding-bottom: clamp(48px, 7vw, 80px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }
  .prompt {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-size: 0.85rem;
    margin-bottom: 26px;
  }
  .g {
    color: var(--accent-ink);
  }
  .greet {
    color: var(--muted);
  }
  h1 {
    font-size: clamp(2.05rem, 2.5vw + 1.15rem, 3.7rem);
    line-height: 1.08;
    letter-spacing: -0.05em;
  }
  .roles {
    margin-top: 26px;
    font-size: clamp(0.9rem, 0.4vw + 0.82rem, 1.05rem);
    min-height: 1.6em;
  }
  .roles .faint {
    margin-right: 0.6ch;
  }
  .caret {
    color: var(--accent-ink);
    animation: blink 1.05s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .intro {
    margin-top: 18px;
    max-width: 52ch;
    color: var(--muted);
    font-size: clamp(1rem, 0.35vw + 0.95rem, 1.12rem);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .ledger {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    margin: clamp(56px, 8vw, 96px) 0 0;
    border-top: 1px solid var(--border);
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
    padding: 20px 24px 0 0;
  }
  .stat + .stat {
    padding-left: 24px;
    border-left: 1px solid var(--border);
  }
  .stat dd {
    margin: 0;
    font-size: clamp(2rem, 1.8vw + 1.2rem, 2.8rem);
    line-height: 1;
  }
  .stat dt {
    font-size: 0.74rem;
    color: var(--faint);
    text-transform: lowercase;
  }

  @media (max-width: 959px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 599px) {
    .ledger {
      grid-template-columns: minmax(0, 1fr);
    }
    .stat,
    .stat + .stat {
      flex-direction: row-reverse;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
      padding: 14px 0;
      border-left: 0;
      border-bottom: 1px solid var(--border);
    }
    .stat dd {
      font-size: 1.9rem;
    }
    .stat dt {
      text-align: right;
      max-width: 16ch;
    }
  }
</style>

<script>
  // Typewriter for the rotating roles line.
  const el = document.querySelector<HTMLElement>('[data-typed]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduce) {
    let roles: string[] = [];
    try {
      roles = JSON.parse(el.dataset.roles || '[]');
    } catch {
      roles = [];
    }
    if (roles.length > 1) {
      let r = 0;
      let i = roles[0].length;
      let deleting = true;
      const tick = () => {
        const word = roles[r];
        if (deleting) {
          i--;
          if (i <= 0) {
            deleting = false;
            r = (r + 1) % roles.length;
          }
        } else {
          i++;
          if (i >= roles[r].length) {
            deleting = true;
            el.textContent = roles[r];
            setTimeout(tick, 2400);
            return;
          }
        }
        el.textContent = (deleting ? word : roles[r]).slice(0, Math.max(i, 0));
        setTimeout(tick, deleting ? 30 : 65);
      };
      setTimeout(tick, 3000);
    }
  }
</script>
