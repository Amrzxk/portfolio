---
import Icon from '../Icon.astro';
import { about, isEnabled, resume, site, skills, story } from '../../lib/data';

const slug = (s: string) =>
  s
    .toLowerCase()
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const handle = slug(site.name.split(' ')[0] || 'me');
// "App & Web Development" → "app-web" so the terminal columns stay tidy.
const shortSlug = (s: string) =>
  slug(s)
    .split('-')
    .filter((w) => w !== 'and')
    .slice(0, 2)
    .join('-');
const rows = skills.domains.map((d) => ({
  name: shortSlug(d.name),
  ready: `${d.skills.length}/${d.skills.length}`,
}));
const showResume = story.showResumeButton && isEnabled('resume') && !!resume.file;
---

<section id="hero" class="hero">
  <div class="glow" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="prompt mono reveal">{story.prompt}</p>
      {story.greeting && <p class="greeting reveal" style="--d:1">{story.greeting}</p>}
      <h1 class="reveal" style="--d:2">{story.headline}</h1>

      <p class="roles mono reveal" style="--d:3">
        <span class="sr-only">{story.roles.join(', ')}</span>
        <span aria-hidden="true" class="roles-line">
          <span class="caret-prefix">&gt;</span>
          <span data-typed data-roles={JSON.stringify(story.roles)}>{story.roles[0]}</span><span class="cursor"></span>
        </span>
      </p>

      {story.intro && <p class="intro reveal" style="--d:4">{story.intro}</p>}

      <div class="ctas reveal" style="--d:5">
        <a class="btn btn-primary" href={story.primaryCta.href}>
          {story.primaryCta.label}
          <Icon name="arrow" size={18} />
        </a>
        {
          showResume && (
            <a class="btn" href={resume.file} download>
              <Icon name="download" size={18} />
              Résumé
            </a>
          )
        }
      </div>

      {
        site.socials.length > 0 && (
          <ul class="socials reveal" style="--d:6" aria-label="Social links">
            {site.socials.map((s) => (
              <li>
                <a class="icon-btn" href={s.url} target={s.url.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer" aria-label={s.label}>
                  <Icon name={s.icon} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="terminal reveal" style="--d:3" aria-hidden="true">
      <div class="term-bar">
        <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
        <span class="term-title mono">{story.terminalTitle}</span>
      </div>
      <div class="term-body mono">
        <p class="line" style="--l:0"><span class="ps">$</span> kubectl get skills -n {handle}</p>
        <p class="line head" style="--l:1"><span>NAME</span><span>READY</span><span>STATUS</span></p>
        {
          rows.map((r, i) => (
            <p class="line row" style={`--l:${i + 2}`}>
              <span>{r.name}</span>
              <span>{r.ready}</span>
              <span class="ok">Running</span>
            </p>
          ))
        }
        <p class="line" style={`--l:${rows.length + 2}`}><span class="ps">$</span> cat status.json</p>
        <p class="line json" style={`--l:${rows.length + 3}`}>
          {'{'} <span class="k">"available"</span>: <span class="v">{String(about.availability.open)}</span>,
          <span class="k">"focus"</span>: <span class="s">"{about.availability.text || site.role}"</span> {'}'}
        </p>
        <p class="line" style={`--l:${rows.length + 4}`}><span class="ps">$</span> <span class="cursor"></span></p>
      </div>
    </div>
  </div>

  {
    story.stats.length > 0 && (
      <div class="container">
        <dl class="stats">
          {story.stats.map((s, i) => (
            <div class="stat reveal" style={`--d:${i + 6}`}>
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }

  <span class="scroll-hint" aria-hidden="true"><span></span></span>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: calc(var(--nav-h) + clamp(32px, 6vw, 64px));
    padding-bottom: clamp(64px, 8vw, 96px);
    isolation: isolate;
    overflow: clip;
  }
  .glow {
    position: absolute;
    z-index: -1;
    top: -10%;
    right: -10%;
    width: min(70vw, 760px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-glow) 0%, transparent 65%);
    filter: blur(20px);
    animation: drift 18s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes drift {
    to {
      transform: translate(-12%, 14%) scale(1.1);
    }
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .prompt {
    color: var(--accent-ink);
    font-size: 0.9rem;
    margin-bottom: 18px;
  }
  .greeting {
    font-size: clamp(1.05rem, 0.6vw + 1rem, 1.3rem);
    color: var(--muted);
    margin-bottom: 10px;
  }
  h1 {
    font-size: clamp(2.3rem, 4.2vw + 1rem, 4.4rem);
    letter-spacing: -0.035em;
    line-height: 1.04;
  }
  .roles {
    margin-top: 22px;
    font-size: clamp(1rem, 0.6vw + 0.9rem, 1.25rem);
    min-height: 1.6em;
  }
  .caret-prefix {
    color: var(--accent-ink);
    margin-right: 8px;
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 3px;
    vertical-align: -0.18em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .intro {
    margin-top: 20px;
    max-width: 58ch;
    color: var(--muted);
    font-size: clamp(1rem, 0.4vw + 0.95rem, 1.14rem);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .socials {
    display: flex;
    gap: 4px;
    margin-top: 24px;
    margin-left: -10px;
  }

  /* Terminal */
  .terminal {
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    background: color-mix(in oklab, var(--surface) 92%, transparent);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }
  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .r {
    background: #ff5f57;
  }
  .y {
    background: #febc2e;
  }
  .g {
    background: #28c840;
  }
  .term-title {
    margin-left: 10px;
    font-size: 0.78rem;
    color: var(--faint);
  }
  .term-body {
    padding: 18px 18px 22px;
    font-size: clamp(0.74rem, 0.3vw + 0.68rem, 0.86rem);
    line-height: 1.85;
    color: var(--muted);
    overflow-x: auto;
  }
  .line {
    white-space: nowrap;
    opacity: 0;
    animation: lineIn 0.35s var(--ease) forwards;
    animation-delay: calc(0.9s + var(--l) * 0.22s);
  }
  @keyframes lineIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .ps {
    color: var(--accent-ink);
  }
  .line:first-child {
    color: var(--text);
  }
  .head,
  .row {
    display: grid;
    grid-template-columns: 1.6fr 0.7fr 1fr;
    gap: 12px;
  }
  .head {
    color: var(--faint);
  }
  .row {
    color: var(--text);
  }
  .ok {
    color: var(--success);
  }
  .k {
    color: var(--accent-ink);
  }
  .v {
    color: #f59e0b;
  }
  .s {
    color: var(--success);
  }
  .json {
    white-space: normal;
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1px;
    margin: clamp(48px, 7vw, 80px) 0 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--border);
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    padding: 22px 24px;
    background: var(--bg);
  }
  .stat dd {
    margin: 0;
    font-size: clamp(1.7rem, 2vw + 1rem, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .stat dt {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 22px;
    width: 24px;
    height: 38px;
    margin-left: -12px;
    border: 1.5px solid var(--border-strong);
    border-radius: 14px;
  }
  .scroll-hint span {
    position: absolute;
    top: 7px;
    left: 50%;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--accent);
    animation: wheel 1.8s ease-in-out infinite;
  }
  @keyframes wheel {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (max-width: 899px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .terminal {
      order: 2;
    }
    .scroll-hint {
      display: none;
    }
  }
  @media (max-height: 700px) {
    .scroll-hint {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .line {
      opacity: 1;
    }
    .glow {
      animation: none;
    }
  }
</style>

<script>
  // Typewriter for the rotating roles line.
  const el = document.querySelector<HTMLElement>('[data-typed]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduce) {
    let roles: string[] = [];
    try {
      roles = JSON.parse(el.dataset.roles || '[]');
    } catch {
      roles = [];
    }
    if (roles.length > 1) {
      let r = 0;
      let i = roles[0].length;
      let deleting = true;
      const tick = () => {
        const word = roles[r];
        if (deleting) {
          i--;
          if (i <= 0) {
            deleting = false;
            r = (r + 1) % roles.length;
          }
        } else {
          i++;
          if (i >= roles[r].length) {
            deleting = true;
            el.textContent = roles[r];
            setTimeout(tick, 2200);
            return;
          }
        }
        el.textContent = (deleting ? word : roles[r]).slice(0, Math.max(i, 0));
        setTimeout(tick, deleting ? 35 : 70);
      };
      setTimeout(tick, 2600);
    }
  }
</script>
