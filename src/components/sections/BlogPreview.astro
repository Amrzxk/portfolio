---
import PostCard from '../PostCard.astro';
import SectionHead from '../SectionHead.astro';
import { getPosts } from '../../lib/collections';
import { sectionIntro } from '../../lib/data';

interface Props {
  title: string;
  kicker: string;
}
const { title, kicker } = Astro.props;
const posts = await getPosts();
const latest = posts.slice(0, 3);
---

{
  latest.length > 0 && (
    <section id="blog" class="section">
      <div class="container">
        <SectionHead kicker={kicker} title={title} intro={sectionIntro('blog')} />
        <div class="list">
          {latest.map((p, i) => (
            <PostCard post={p} index={i} />
          ))}
        </div>
        <a class="link all reveal" href="/blog/">
          all posts ({posts.length}) <span class="arr" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  )
}

<style>
  .list {
    border-top: 1px solid var(--border);
  }
  .all {
    margin-top: 24px;
  }
  @media (max-width: 759px) {
    .all {
      margin-left: 0;
    }
  }
</style>
