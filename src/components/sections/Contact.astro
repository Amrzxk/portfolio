---
import SectionHead from '../SectionHead.astro';
import { contact, site } from '../../lib/data';

interface Props {
  title: string;
  kicker: string;
}
const { title, kicker } = Astro.props;
const showEmail = contact.showEmail && !!site.email;
const pretty = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<section id="contact" class="section">
  <div class="container">
    <SectionHead kicker={kicker} title={title} intro={contact.intro} />

    <div class="grid">
      <dl class="channels mono reveal">
        {
          showEmail && (
            <div>
              <dt>mail</dt>
              <dd>
                <a class="u" href={`mailto:${site.email}`}>
                  {site.email}
                </a>
              </dd>
            </div>
          )
        }
        {
          site.socials
            .filter((s) => !s.url.startsWith('mailto:'))
            .map((s) => (
              <div>
                <dt>{s.label.toLowerCase()}</dt>
                <dd>
                  <a class="u" href={s.url} target="_blank" rel="noopener noreferrer">
                    {pretty(s.url)} ↗
                  </a>
                </dd>
              </div>
            ))
        }
        {
          site.location && (
            <div>
              <dt>based</dt>
              <dd>{site.location}</dd>
            </div>
          )
        }
      </dl>

      <form class="form reveal" novalidate data-contact data-endpoint={contact.endpoint} data-email={site.email} data-success={contact.successMessage}>
        <div class="row">
          <label class="field">
            <span class="lbl mono">name</span>
            <input name="name" type="text" autocomplete="name" required maxlength="100" placeholder="Ada Lovelace" />
            <em class="err" aria-live="polite"></em>
          </label>
          <label class="field">
            <span class="lbl mono">email</span>
            <input name="email" type="email" autocomplete="email" required maxlength="200" placeholder="ada@example.com" />
            <em class="err" aria-live="polite"></em>
          </label>
        </div>
        <label class="field">
          <span class="lbl mono">subject <span class="faint">(optional)</span></span>
          <input name="subject" type="text" maxlength="150" placeholder="A platform migration, a role, a question…" />
        </label>
        <label class="field">
          <span class="lbl mono">message</span>
          <textarea name="message" rows="5" required minlength="10" maxlength="5000" placeholder="Tell me what you're working on."></textarea>
          <em class="err" aria-live="polite"></em>
        </label>
        <!-- Honeypot: humans never see or fill this -->
        <label class="hp" aria-hidden="true">
          Company <input name="company" type="text" tabindex="-1" autocomplete="off" />
        </label>
        <div class="send">
          <button class="btn btn-primary submit" type="submit">
            <span class="label">send message</span>
            <span class="arr" aria-hidden="true">→</span>
          </button>
          <p class="status" role="status" aria-live="polite" data-status></p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 32px 24px;
  }
  .channels {
    display: grid;
    align-content: start;
    gap: 16px;
    margin: 0;
    font-size: 0.82rem;
  }
  .channels dt {
    font-size: 0.7rem;
    color: var(--faint);
  }
  .channels dd {
    margin: 2px 0 0;
    overflow-wrap: anywhere;
  }
  .form {
    display: grid;
    gap: 28px;
    max-width: 760px;
  }
  .row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }
  .field {
    display: grid;
    gap: 6px;
  }
  .lbl {
    font-size: 0.74rem;
    color: var(--muted);
  }
  input,
  textarea {
    width: 100%;
    padding: 8px 0 10px;
    border: 0;
    border-bottom: 1.5px solid var(--border-strong);
    border-radius: 0;
    background: transparent;
    color: var(--text);
    font: 400 1.08rem/1.5 var(--font-sans);
    transition: border-color 0.25s;
  }
  :root[data-theme='light'] input,
  :root[data-theme='light'] textarea {
    border-bottom-color: var(--underline);
  }
  input::placeholder,
  textarea::placeholder {
    color: var(--faint);
    opacity: 0.7;
  }
  textarea {
    resize: vertical;
    min-height: 120px;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--accent-ink) !important;
  }
  .field.invalid input,
  .field.invalid textarea {
    border-bottom-color: var(--danger) !important;
  }
  .err {
    font: normal 0.76rem var(--font-mono);
    color: var(--danger);
  }
  .err:empty {
    display: none;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .send {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }
  .status {
    font: 0.84rem var(--font-mono);
  }
  .status:empty {
    display: none;
  }
  .status.ok {
    color: var(--success);
  }
  .status.bad {
    color: var(--danger);
  }
  .status :global(a) {
    text-decoration: underline;
  }
  @media (max-width: 759px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 519px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
    .submit {
      width: 100%;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    const startedAt = Date.now();
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = btn.querySelector<HTMLElement>('.label')!;
    const endpoint = form.dataset.endpoint || '';
    const email = form.dataset.email || '';

    const setError = (name: string, msg: string) => {
      const input = form.elements.namedItem(name) as HTMLInputElement;
      const field = input.closest('.field')!;
      field.classList.toggle('invalid', !!msg);
      const err = field.querySelector('.err');
      if (err) err.textContent = msg;
      input.setAttribute('aria-invalid', msg ? 'true' : 'false');
    };

    const validate = (data: Record<string, string>) => {
      let ok = true;
      const checks: [string, string][] = [
        ['name', data.name.trim() ? '' : 'Please enter your name.'],
        ['email', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email.trim()) ? '' : 'Please enter a valid email address.'],
        ['message', data.message.trim().length >= 10 ? '' : 'Your message should be at least 10 characters.'],
      ];
      for (const [name, msg] of checks) {
        setError(name, msg);
        if (msg) ok = false;
      }
      return ok;
    };

    const fallback = (data: Record<string, string>) => {
      if (!email) return '';
      const href = `mailto:${email}?subject=${encodeURIComponent(data.subject || 'Hello from your portfolio')}&body=${encodeURIComponent(data.message)}`;
      return ` You can also <a href="${href}">email me directly</a>.`;
    };

    const show = (cls: 'ok' | 'bad' | '', html: string) => {
      status.className = `status ${cls}`;
      status.innerHTML = html;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const data = Object.fromEntries([...fd.entries()].map(([k, v]) => [k, String(v)])) as Record<string, string>;
      if (!validate(data)) {
        (form.querySelector('[aria-invalid=true]') as HTMLElement | null)?.focus();
        return;
      }
      if (!endpoint) {
        show('bad', 'The contact form isn’t connected yet.' + fallback(data));
        return;
      }
      btn.disabled = true;
      label.textContent = 'sending…';
      show('', '');
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          // text/plain keeps this a "simple" request — no CORS preflight for Apps Script.
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ ...data, elapsedMs: Date.now() - startedAt, page: location.href }),
        });
        const json = await res.json().catch(() => ({ ok: res.ok }));
        if (!res.ok || !json.ok) throw new Error(json.error || `HTTP ${res.status}`);
        form.reset();
        show('ok', '✓ ' + (form.dataset.success || 'Thanks! Message sent.'));
      } catch (err) {
        console.error('Contact form failed:', err);
        show('bad', 'Sorry — your message could not be sent right now.' + fallback(data));
      } finally {
        btn.disabled = false;
        label.textContent = 'send message';
      }
    });
  }
</script>
