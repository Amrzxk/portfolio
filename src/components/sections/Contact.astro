---
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import { contact, site } from '../../lib/data';

interface Props {
  title: string;
  kicker: string;
}
const { title, kicker } = Astro.props;
const showEmail = contact.showEmail && !!site.email;
---

<section id="contact" class="section">
  <div class="container contact-grid">
    <div class="side">
      <SectionHead kicker={kicker} title={title} intro={contact.intro} />
      <ul class="channels reveal">
        {
          showEmail && (
            <li>
              <a href={`mailto:${site.email}`}>
                <span class="ch-icon">
                  <Icon name="mail" size={18} />
                </span>
                <span>
                  <small>Email</small>
                  {site.email}
                </span>
              </a>
            </li>
          )
        }
        {
          site.location && (
            <li>
              <span class="ch">
                <span class="ch-icon">
                  <Icon name="pin" size={18} />
                </span>
                <span>
                  <small>Location</small>
                  {site.location}
                </span>
              </span>
            </li>
          )
        }
        {
          site.socials
            .filter((s) => s.icon !== 'mail')
            .map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  <span class="ch-icon">
                    <Icon name={s.icon} size={18} />
                  </span>
                  <span>
                    <small>{s.label}</small>
                    {s.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}
                  </span>
                </a>
              </li>
            ))
        }
      </ul>
    </div>

    <form
      class="card form reveal"
      novalidate
      data-contact
      data-endpoint={contact.endpoint}
      data-email={site.email}
      data-success={contact.successMessage}
    >
      <div class="row">
        <label class="field">
          <span>Name</span>
          <input name="name" type="text" autocomplete="name" required maxlength="100" />
          <em class="err" aria-live="polite"></em>
        </label>
        <label class="field">
          <span>Email</span>
          <input name="email" type="email" autocomplete="email" required maxlength="200" />
          <em class="err" aria-live="polite"></em>
        </label>
      </div>
      <label class="field">
        <span>Subject <small class="muted">(optional)</small></span>
        <input name="subject" type="text" maxlength="150" />
      </label>
      <label class="field">
        <span>Message</span>
        <textarea name="message" rows="6" required minlength="10" maxlength="5000"></textarea>
        <em class="err" aria-live="polite"></em>
      </label>
      <!-- Honeypot: humans never see or fill this -->
      <label class="hp" aria-hidden="true">
        Company <input name="company" type="text" tabindex="-1" autocomplete="off" />
      </label>
      <button class="btn btn-primary submit" type="submit">
        <span class="label">Send message</span>
        <Icon name="send" size={18} />
      </button>
      <p class="status" role="status" aria-live="polite" data-status></p>
    </form>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .channels {
    display: grid;
    gap: 10px;
  }
  .channels a,
  .channels .ch {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 0;
    min-height: 44px;
    word-break: break-word;
  }
  .channels a:hover {
    color: var(--accent-ink);
  }
  .channels small {
    display: block;
    color: var(--faint);
    font: 500 0.72rem/1.3 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .ch-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--accent-ink);
  }
  .form {
    display: grid;
    gap: 18px;
  }
  .row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .field {
    display: grid;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 500;
  }
  input,
  textarea {
    width: 100%;
    padding: 12px 14px;
    min-height: 46px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--bg);
    color: var(--text);
    font: 400 1rem/1.5 var(--font-sans);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  textarea {
    resize: vertical;
    min-height: 140px;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .field.invalid input,
  .field.invalid textarea {
    border-color: var(--danger);
  }
  .err {
    font-style: normal;
    font-size: 0.8rem;
    color: var(--danger);
    min-height: 0;
  }
  .err:empty {
    display: none;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .submit {
    justify-self: start;
  }
  .status {
    font-size: 0.95rem;
  }
  .status:empty {
    display: none;
  }
  .status.ok {
    color: var(--success);
  }
  .status.bad {
    color: var(--danger);
  }
  .status a {
    text-decoration: underline;
  }
  @media (max-width: 859px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 519px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
    .submit {
      justify-self: stretch;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    const startedAt = Date.now();
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = btn.querySelector<HTMLElement>('.label')!;
    const endpoint = form.dataset.endpoint || '';
    const email = form.dataset.email || '';

    const setError = (name: string, msg: string) => {
      const input = form.elements.namedItem(name) as HTMLInputElement;
      const field = input.closest('.field')!;
      field.classList.toggle('invalid', !!msg);
      const err = field.querySelector('.err');
      if (err) err.textContent = msg;
      input.setAttribute('aria-invalid', msg ? 'true' : 'false');
    };

    const validate = (data: Record<string, string>) => {
      let ok = true;
      const checks: [string, string][] = [
        ['name', data.name.trim() ? '' : 'Please enter your name.'],
        ['email', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email.trim()) ? '' : 'Please enter a valid email address.'],
        ['message', data.message.trim().length >= 10 ? '' : 'Your message should be at least 10 characters.'],
      ];
      for (const [name, msg] of checks) {
        setError(name, msg);
        if (msg) ok = false;
      }
      return ok;
    };

    const fallback = (data: Record<string, string>) => {
      if (!email) return '';
      const href = `mailto:${email}?subject=${encodeURIComponent(data.subject || 'Hello from your portfolio')}&body=${encodeURIComponent(data.message)}`;
      return ` You can also <a href="${href}">email me directly</a>.`;
    };

    const show = (cls: 'ok' | 'bad' | '', html: string) => {
      status.className = `status ${cls}`;
      status.innerHTML = html;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const data = Object.fromEntries([...fd.entries()].map(([k, v]) => [k, String(v)])) as Record<string, string>;
      if (!validate(data)) {
        (form.querySelector('[aria-invalid=true]') as HTMLElement | null)?.focus();
        return;
      }
      if (!endpoint) {
        show('bad', 'The contact form isn’t connected yet.' + fallback(data));
        return;
      }
      btn.disabled = true;
      label.textContent = 'Sending…';
      show('', '');
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          // text/plain keeps this a "simple" request — no CORS preflight for Apps Script.
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ ...data, elapsedMs: Date.now() - startedAt, page: location.href }),
        });
        const json = await res.json().catch(() => ({ ok: res.ok }));
        if (!res.ok || !json.ok) throw new Error(json.error || `HTTP ${res.status}`);
        form.reset();
        show('ok', form.dataset.success || 'Thanks! Message sent.');
      } catch (err) {
        console.error('Contact form failed:', err);
        show('bad', 'Sorry — your message could not be sent right now.' + fallback(data));
      } finally {
        btn.disabled = false;
        label.textContent = 'Send message';
      }
    });
  }
</script>
