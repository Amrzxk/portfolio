---
import SectionHead from '../SectionHead.astro';
import { story } from '../../lib/data';

interface Props {
  title: string;
  kicker: string;
}
const { title, kicker } = Astro.props;
---

{
  story.chapters.length > 0 && (
    <section id="story" class="section story">
      <div class="container">
        <SectionHead kicker={kicker} title={title} intro={story.chaptersIntro} />

        <div class="timeline" data-timeline>
          <span class="rail" aria-hidden="true">
            <span class="rail-fill" />
          </span>
          <ol>
          {story.chapters.map((c) => (
            <li class="chapter reveal">
              <span class="node" aria-hidden="true" />
              <p class="marker mono">{c.marker}</p>
              <div class="chapter-card">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.image && <img src={c.image} alt="" loading="lazy" decoding="async" />}
              </div>
            </li>
          ))}
          </ol>
        </div>
      </div>
    </section>
  )
}

<style>
  .timeline {
    --p: 0;
    position: relative;
    max-width: 820px;
    margin-inline: auto;
    padding-left: clamp(36px, 6vw, 64px);
  }
  .rail {
    position: absolute;
    left: clamp(11px, 2vw, 21px);
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .rail-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--accent), color-mix(in oklab, var(--accent) 40%, transparent));
    transform-origin: top;
    transform: scaleY(var(--p));
  }
  .chapter {
    position: relative;
    padding-bottom: clamp(36px, 6vw, 64px);
  }
  .chapter:last-of-type {
    padding-bottom: 0;
  }
  .node {
    position: absolute;
    left: calc(-1 * clamp(36px, 6vw, 64px) + clamp(11px, 2vw, 21px) - 6px);
    top: 4px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--border-strong);
    transition:
      border-color 0.5s,
      box-shadow 0.5s,
      background-color 0.5s;
  }
  .chapter.in .node {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 6px var(--accent-soft);
  }
  .marker {
    font-size: 0.8rem;
    color: var(--accent-ink);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .chapter-card h3 {
    margin-top: 8px;
    font-size: clamp(1.35rem, 1.2vw + 1rem, 1.85rem);
  }
  .chapter-card p {
    margin-top: 12px;
    color: var(--muted);
    font-size: clamp(1rem, 0.3vw + 0.95rem, 1.1rem);
    max-width: 62ch;
  }
  .chapter-card img {
    margin-top: 18px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }
</style>

<script>
  // Fill the timeline rail as the reader scrolls through the story.
  const tl = document.querySelector<HTMLElement>('[data-timeline]');
  if (tl) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = tl.getBoundingClientRect();
      const vh = window.innerHeight;
      const p = Math.min(1, Math.max(0, (vh * 0.65 - r.top) / r.height));
      tl.style.setProperty('--p', p.toFixed(3));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
