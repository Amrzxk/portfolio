---
import SectionHead from '../SectionHead.astro';
import { story } from '../../lib/data';

interface Props {
  title: string;
  kicker: string;
}
const { title, kicker } = Astro.props;
---

{
  story.chapters.length > 0 && (
    <section id="story" class="section">
      <div class="container">
        <SectionHead kicker={kicker} title={title} intro={story.chaptersIntro} />

        <div class="timeline" data-timeline>
          <span class="rail" aria-hidden="true">
            <span class="rail-fill" />
          </span>
          <ol>
            {story.chapters.map((c, i) => (
              <li class="chapter reveal">
                <span class="node" aria-hidden="true" />
                <p class="marker mono">
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  {c.marker}
                </p>
                <div class="body">
                  <h3 class="serif">{c.title}</h3>
                  <p>{c.body}</p>
                  {c.image && <img src={c.image} alt="" loading="lazy" decoding="async" />}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )
}

<style>
  .timeline {
    --p: 0;
    --rail-x: 8px;
    position: relative;
    margin-left: 200px;
    padding-left: 44px;
  }
  .rail {
    position: absolute;
    left: var(--rail-x);
    top: 10px;
    bottom: 10px;
    width: 1px;
    background: var(--border-strong);
  }
  .rail-fill {
    position: absolute;
    inset: 0;
    width: 2px;
    left: -0.5px;
    background: var(--accent-ink);
    transform-origin: top;
    transform: scaleY(var(--p));
  }
  .chapter {
    position: relative;
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: 8px 32px;
    padding-bottom: clamp(40px, 6vw, 72px);
  }
  .chapter:last-child {
    padding-bottom: 0;
  }
  .node {
    position: absolute;
    left: calc(var(--rail-x) - 44px - 4px);
    top: 0.75em;
    width: 9px;
    height: 9px;
    background: var(--bg);
    border: 1px solid var(--border-strong);
    transform: rotate(45deg);
    transition:
      background-color 0.5s,
      border-color 0.5s;
  }
  .chapter.in .node {
    background: var(--accent-ink);
    border-color: var(--accent-ink);
  }
  .marker {
    display: flex;
    gap: 10px;
    padding-top: 0.55em;
    font-size: 0.78rem;
    color: var(--muted);
    text-transform: lowercase;
  }
  .num {
    color: var(--accent-ink);
  }
  .body h3 {
    font-size: clamp(1.8rem, 1.6vw + 1.1rem, 2.5rem);
    line-height: 1.08;
  }
  .body p {
    margin-top: 12px;
    color: var(--muted);
    font-size: clamp(1rem, 0.25vw + 0.96rem, 1.08rem);
    max-width: 60ch;
  }
  .body img {
    margin-top: 20px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  @media (max-width: 959px) {
    .timeline {
      margin-left: 0;
    }
  }
  @media (max-width: 639px) {
    .timeline {
      padding-left: 32px;
      --rail-x: 4px;
    }
    .node {
      left: calc(var(--rail-x) - 32px - 4px);
    }
    .chapter {
      grid-template-columns: minmax(0, 1fr);
    }
    .marker {
      padding-top: 0.3em;
    }
  }
</style>

<script>
  const tl = document.querySelector<HTMLElement>('[data-timeline]');
  if (tl) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = tl.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight * 0.6 - r.top) / r.height));
      tl.style.setProperty('--p', p.toFixed(3));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
