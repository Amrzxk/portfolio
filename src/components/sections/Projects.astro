---
import ProjectCard from '../ProjectCard.astro';
import SectionHead from '../SectionHead.astro';
import { getProjects } from '../../lib/collections';
import { DOMAIN_IDS, DOMAIN_LABELS } from '../../lib/schemas';
import { sectionIntro } from '../../lib/data';

interface Props {
  title: string;
  kicker: string;
}
const { title, kicker } = Astro.props;
const projects = await getProjects();
const used = DOMAIN_IDS.filter((d) => projects.some((p) => p.data.domains.includes(d)));
---

<section id="projects" class="section">
  <div class="container">
    <SectionHead kicker={kicker} title={title} intro={sectionIntro('projects')} />

    {
      used.length > 1 && (
        <div class="filters mono reveal" role="group" aria-label="Filter projects" data-filters>
          <span class="faint lbl">filter:</span>
          <button type="button" class="filter" aria-pressed="true" data-filter="all">
            all<sup>{projects.length}</sup>
          </button>
          {used.map((d) => (
            <button type="button" class="filter" aria-pressed="false" data-filter={d}>
              {DOMAIN_LABELS[d].toLowerCase()}
              <sup>{projects.filter((p) => p.data.domains.includes(d)).length}</sup>
            </button>
          ))}
        </div>
      )
    }

    {
      projects.length > 0 ? (
        <div class="grid" data-project-grid>
          {projects.map((p, i) => (
            <ProjectCard project={p} index={i} />
          ))}
        </div>
      ) : (
        <p class="muted">Projects are coming soon.</p>
      )
    }
    <p class="sr-only" aria-live="polite" data-filter-status></p>
  </div>
</section>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 18px;
    margin-bottom: 28px;
    font-size: 0.82rem;
  }
  .filter {
    min-height: 40px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
    transition:
      color 0.2s,
      text-decoration-color 0.2s;
  }
  .filter:hover {
    color: var(--text);
  }
  .filter[aria-pressed='true'] {
    color: var(--accent-ink);
    text-decoration-color: var(--underline);
  }
  sup {
    margin-left: 3px;
    font-size: 0.68em;
    color: var(--faint);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 20px);
  }
  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 639px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const cards = document.querySelectorAll<HTMLElement>('[data-project-grid] [data-domains]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  bar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!btn) return;
    const f = btn.dataset.filter!;
    bar.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    let shown = 0;
    cards.forEach((c) => {
      const match = f === 'all' || c.dataset.domains!.split(' ').includes(f);
      c.hidden = !match;
      if (match) {
        shown++;
        c.classList.add('in');
      }
    });
    if (status) status.textContent = `Showing ${shown} project${shown === 1 ? '' : 's'}`;
  });
</script>
