---
interface Props {
  kicker: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
}
const { kicker, title, intro, align = 'left' } = Astro.props;
---

<header class:list={['section-head', 'reveal', { center: align === 'center' }]}>
  <p class="kicker">{kicker}</p>
  <h2>{title}</h2>
  {intro && <p>{intro}</p>}
  <slot />
</header>

<style>
  .center {
    margin-inline: auto;
    text-align: center;
  }
  .center .kicker {
    justify-content: center;
  }
</style>
