---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { DOMAIN_LABELS } from '../lib/schemas';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}
const { project, index = 0 } = Astro.props;
const p = project.data;
const href = `/projects/${project.id}/`;
const num = String(index + 1).padStart(2, '0');
const year = p.date ? p.date.getUTCFullYear() : '';
---

<article class="project reveal" data-domains={p.domains.join(' ')} style={`--d:${index % 3}`}>
  <div class="visual">
    {
      p.cover ? (
        <img src={p.cover} alt="" loading="lazy" decoding="async" />
      ) : (
        <div class="plate" aria-hidden="true">
          <span class="path mono">~/projects/{project.id}</span>
          <span class="big serif">{num}</span>
          <span class="tree mono">
            {p.stack.slice(0, 3).map((s, i, a) => (
              <span>
                {i === a.length - 1 ? '└─' : '├─'} {s}
              </span>
            ))}
          </span>
        </div>
      )
    }
  </div>

  <div class="body">
    <p class="meta mono">
      <span class="n">{num}</span>
      <span>{p.domains.map((d) => DOMAIN_LABELS[d].toLowerCase()).join(' + ')}</span>
      {year && <span class="yr">{year}</span>}
    </p>
    <h3>
      <a href={href} class="stretched">{p.title}</a>
      {p.featured && <span class="star mono" title="Featured">★</span>}
    </h3>
    <p class="summary">{p.summary}</p>
    {p.stack.length > 0 && <p class="stack mono">{p.stack.join(' / ')}</p>}
    <div class="links">
      <span class="link">read case study <span class="arr" aria-hidden="true">→</span></span>
      <span class="ext">
        {
          p.repo && (
            <a class="icon-btn" href={p.repo} target="_blank" rel="noopener noreferrer" aria-label={`${p.title} source code`}>
              <Icon name="github" size={17} />
            </a>
          )
        }
        {
          p.live && (
            <a class="icon-btn" href={p.live} target="_blank" rel="noopener noreferrer" aria-label={`${p.title} live site`}>
              <Icon name="external" size={17} />
            </a>
          )
        }
      </span>
    </div>
  </div>
</article>

<style>
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.25s;
  }
  .project:hover {
    border-color: var(--accent-line);
  }
  .project[hidden] {
    display: none;
  }
  .visual {
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35);
    transition:
      filter 0.5s,
      transform 0.6s var(--ease);
  }
  .project:hover .visual img {
    filter: none;
    transform: scale(1.03);
  }
  .plate {
    position: relative;
    height: 100%;
    padding: 16px 18px;
    background: var(--term-bg);
    color: var(--term-dim);
    overflow: hidden;
  }
  .plate::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, rgb(255 255 255 / 0.02) 0 1px, transparent 1px 3px);
    pointer-events: none;
  }
  .path {
    font-size: 0.7rem;
  }
  .big {
    position: absolute;
    right: 14px;
    bottom: -0.18em;
    font-size: clamp(6rem, 9vw, 8.5rem);
    line-height: 1;
    font-style: italic;
    color: var(--accent);
    opacity: 0.9;
    transition: transform 0.6s var(--ease);
  }
  .project:hover .big {
    transform: translateY(-6px);
  }
  .tree {
    position: absolute;
    left: 18px;
    bottom: 16px;
    display: grid;
    gap: 2px;
    font-size: 0.7rem;
    color: var(--term-text);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    padding: 20px 22px 16px;
  }
  .meta {
    display: flex;
    gap: 12px;
    font-size: 0.72rem;
    color: var(--faint);
  }
  .meta .n {
    color: var(--accent-ink);
  }
  .yr {
    margin-left: auto;
  }
  h3 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.25;
  }
  h3 a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 0.25s;
  }
  .project:hover h3 a {
    text-decoration-color: var(--underline);
  }
  .star {
    font-size: 0.8rem;
    color: var(--accent-ink);
  }
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .summary {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .stack {
    font-size: 0.72rem;
    color: var(--faint);
    line-height: 1.6;
  }
  .links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 6px;
  }
  .ext {
    display: flex;
    position: relative;
    z-index: 2;
  }
</style>
