---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getPosts } from '../../lib/collections';
import { sectionIntro, sectionTitle } from '../../lib/data';

const posts = await getPosts();
const title = sectionTitle('blog', 'Writing');
const intro = sectionIntro('blog');
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base title={title} description={intro || `Articles and notes — ${title}`}>
  <section class="page">
    <div class="container">
      <a class="back mono" href="/">← home</a>
      <SectionHead kicker={`${String(posts.length).padStart(2, '0')} · blog`} title={title} intro={intro}>
        <a class="u rss mono" href="/rss.xml">subscribe via rss</a>
      </SectionHead>

      {
        tags.length > 1 && (
          <div class="tags mono" role="group" aria-label="Filter by tag" data-tags>
            <span class="faint">tags:</span>
            <button type="button" class="tag" aria-pressed="true" data-tag="">
              all
            </button>
            {tags.map((t) => (
              <button type="button" class="tag" aria-pressed="false" data-tag={t}>
                #{t}
              </button>
            ))}
          </div>
        )
      }

      {
        posts.length ? (
          <div class="list">
            {posts.map((p, i) => (
              <div data-post-tags={p.data.tags.join(' ')}>
                <PostCard post={p} index={i} headingLevel="h2" />
              </div>
            ))}
          </div>
        ) : (
          <p class="muted">No posts yet — check back soon.</p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .page {
    padding: calc(var(--nav-h) + clamp(32px, 6vw, 72px)) 0 clamp(48px, 8vw, 96px);
  }
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 16px;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .back:hover {
    color: var(--accent-ink);
  }
  .rss {
    display: inline-block;
    margin-top: 14px;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
    margin-bottom: 20px;
    font-size: 0.8rem;
  }
  .tag {
    min-height: 40px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
  }
  .tag[aria-pressed='true'] {
    color: var(--accent-ink);
    text-decoration-color: var(--underline);
  }
  .list {
    border-top: 1px solid var(--border);
  }
  .list > div[hidden] {
    display: none;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-tags]');
  bar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tag]');
    if (!btn) return;
    const tag = btn.dataset.tag!;
    bar.querySelectorAll('[data-tag]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    document.querySelectorAll<HTMLElement>('[data-post-tags]').forEach((el) => {
      el.hidden = !!tag && !el.dataset.postTags!.split(' ').includes(tag);
      el.querySelector('.reveal')?.classList.add('in');
    });
  });
</script>
