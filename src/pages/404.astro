---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found">
  <section class="nf">
    <div class="container">
      <p class="mono code">HTTP 404 · route not found</p>
      <h1>This path isn't in the cluster.</h1>
      <p class="muted">The page you're looking for was moved, renamed, or never deployed.</p>
      <pre class="mono" aria-hidden="true"><span class="ps">$</span> kubectl get page {'<this-page>'}
Error from server (NotFound): pages "{'<this-page>'}" not found</pre>
      <a class="btn btn-primary" href="/"><Icon name="back" size={18} /> Back home</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 80svh;
    display: grid;
    align-items: center;
    padding-top: var(--nav-h);
  }
  .code {
    color: var(--accent-ink);
    font-size: 0.9rem;
  }
  h1 {
    margin: 14px 0 12px;
    font-size: clamp(2rem, 4vw + 1rem, 3.6rem);
  }
  pre {
    margin: 28px 0;
    padding: 16px 18px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.85rem;
    white-space: pre-wrap;
    overflow-x: auto;
  }
  .ps {
    color: var(--accent-ink);
  }
</style>
